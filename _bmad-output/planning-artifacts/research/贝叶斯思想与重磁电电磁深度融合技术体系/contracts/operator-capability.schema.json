{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operator-capability.schema.json",
  "title": "GeoDeepBayes operator capability contract v2",
  "type": "object",
  "required": ["schema_version", "operator_id", "method", "maturity", "implementation", "verification", "allowed_claims"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "operator_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "method": {"enum": ["gravity", "magnetic", "dc", "tdip", "sip_fdip", "tem", "mt_amt", "csamt", "wfem"]},
    "maturity": {"enum": ["Planned", "Implemented", "Unit-verified", "Synthetic-verified", "Field-validated"]},
    "implementation": {
      "type": ["object", "null"],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      },
      "required": ["module", "symbol"],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["unit_tests", "synthetic_runs", "field_runs"],
      "properties": {
        "unit_tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "synthetic_runs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "field_runs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "allowed_claims": {
      "type": "array",
      "items": {"enum": ["design", "implemented", "unit-behavior", "synthetic", "field"]}
    }
  },
  "additionalProperties": false
}
