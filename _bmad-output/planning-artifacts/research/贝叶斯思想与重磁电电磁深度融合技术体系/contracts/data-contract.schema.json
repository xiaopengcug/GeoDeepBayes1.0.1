{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "data-contract.schema.json",
  "title": "GeoDeepBayes observation contract v2",
  "type": "object",
  "required": [
    "schema_version", "dataset_id", "method", "data", "coordinates",
    "acquisition", "sampling", "uncertainty", "nuisance", "applicability"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "method": {
      "enum": ["gravity", "magnetic", "dc", "tdip", "sip_fdip", "tem", "mt_amt", "csamt", "wfem"]
    },
    "data": {
      "type": "object",
      "required": ["vector_layout", "components", "units", "realification"],
      "properties": {
        "vector_layout": {"type": "string", "minLength": 1},
        "components": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "units": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "realification": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "required": ["horizontal_crs", "vertical_reference", "axis_order", "z_positive", "coordinate_unit", "sign_convention"],
      "properties": {
        "horizontal_crs": {"type": ["string", "null"]},
        "vertical_reference": {"type": ["string", "null"]},
        "axis_order": {"type": ["string", "null"]},
        "z_positive": {"enum": ["up", "down", "unknown"]},
        "coordinate_unit": {"type": ["string", "null"]},
        "sign_convention": {"type": "string", "minLength": 1},
        "transform_error": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "acquisition": {
      "type": "object",
      "required": ["source_geometry", "receiver_geometry", "geometry_units"],
      "properties": {
        "source_geometry": {"type": "string", "minLength": 1},
        "receiver_geometry": {"type": "string", "minLength": 1},
        "geometry_units": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": ["frequencies_hz", "time_windows_s"],
      "properties": {
        "frequencies_hz": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0},
          "uniqueItems": true
        },
        "time_windows_s": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0},
              {"type": "number", "exclusiveMinimum": 0}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": ["absolute_floor", "relative_floor", "covariance"],
      "properties": {
        "absolute_floor": {"type": "number", "minimum": 0},
        "relative_floor": {"type": "number", "minimum": 0},
        "covariance": {
          "type": "object",
          "required": ["representation", "reference"],
          "properties": {
            "representation": {"enum": ["diagonal", "dense", "sparse", "kernel", "unknown"]},
            "reference": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nuisance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "unit", "support", "owner"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "support": {"type": "string", "minLength": 1},
          "owner": {"enum": ["geometry", "instrument", "timing", "noise"]}
        },
        "additionalProperties": false
      }
    },
    "applicability": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"method": {"enum": ["sip_fdip", "mt_amt", "csamt", "wfem"]}}},
      "then": {"properties": {"sampling": {"properties": {"frequencies_hz": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"method": {"enum": ["tdip", "tem"]}}},
      "then": {"properties": {"sampling": {"properties": {"time_windows_s": {"minItems": 1}}}}}
    }
  ],
  "additionalProperties": false
}
