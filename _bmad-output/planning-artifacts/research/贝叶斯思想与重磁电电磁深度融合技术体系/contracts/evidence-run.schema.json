{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-run.schema.json",
  "title": "GeoDeepBayes evidence run contract v2",
  "type": "object",
  "required": [
    "schema_version", "run_id", "evidence_id", "execution", "code",
    "inputs", "configs", "outputs", "environment", "randomness",
    "approval", "claims", "attestation"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+-[0-9]{3}$"},
    "execution": {
      "type": "object",
      "required": ["started_at", "ended_at", "outcome", "exit_code", "failure_reason"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "outcome": {"enum": ["succeeded", "failed", "blocked"]},
        "exit_code": {"type": "integer"},
        "failure_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "code": {"$ref": "#/$defs/artifact_root"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "configs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "environment": {
      "type": "object",
      "required": ["os", "architecture", "python_version", "python_sha256", "uv_lock_sha256"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "pattern": "^3\\.11\\.[0-9]+$"},
        "python_sha256": {"$ref": "#/$defs/sha256"},
        "uv_lock_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "randomness": {
      "type": "object",
      "required": ["stochastic", "seeds"],
      "properties": {
        "stochastic": {"type": "boolean"},
        "seeds": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["identity", "identity_type", "decided_at", "decision"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "identity_type": {"enum": ["human", "ai", "service"]},
        "decided_at": {"type": "string", "format": "date-time"},
        "decision": {"enum": ["pending", "approved", "rejected"]}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "scope", "max_maturity"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "scope": {"enum": ["design", "implemented", "unit-behavior", "synthetic", "field"]},
          "max_maturity": {"enum": ["Planned", "Implemented", "Unit-verified", "Synthetic-verified", "Field-validated"]}
        },
        "additionalProperties": false
      }
    },
    "attestation": {
      "type": "object",
      "required": ["required", "subject_digest", "workflow", "commit_sha", "verified"],
      "properties": {
        "required": {"type": "boolean"},
        "subject_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "workflow": {"type": ["string", "null"]},
        "commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "verified": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "locator": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifact_root": {
      "type": "object",
      "required": ["algorithm", "manifest", "sha256"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-manifest-v1"},
        "manifest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
