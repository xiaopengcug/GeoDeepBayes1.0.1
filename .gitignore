# Python与测试缓存
.venv/
.venv-*/
**/.venv-*/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
coverage.xml

# 本机与编辑器状态
.claude/
.cursor/
.trae/
.benchmarks/
/.agents/
/.specify/
/.tmp-wp8-midu-inspect/
*.log

# 开放数据、运行工作区及历史版本副本不进入Git
_bmad-output/planning-artifacts/research/open-data/
!_bmad-output/planning-artifacts/research/open-data/
_bmad-output/planning-artifacts/research/open-data/*
!_bmad-output/planning-artifacts/research/open-data/00_catalog/
_bmad-output/planning-artifacts/research/open-data/00_catalog/*
!_bmad-output/planning-artifacts/research/open-data/00_catalog/open_geophysics_data_manifest.json
**/validation/**/work/
**/validation/**/source/
**/validation/**/versions/
# Git may see only the active WP2-WP5 version closure. The persistence builder
# derives that exact set from active-output pointers, and repository-scope
# rejects any tracked historical version.
!**/validation/wp2-toy/versions/
!**/validation/wp2-toy/versions/**
!**/validation/wp3-physics/versions/
!**/validation/wp3-physics/versions/**
!**/validation/wp4-decision/versions/
!**/validation/wp4-decision/versions/**
!**/validation/wp5-consistency/versions/
!**/validation/wp5-consistency/versions/**
!**/validation/wp7/versions/
!**/validation/wp7/versions/**
**/validation/**/attempts/
**/validation/**/selftest-results/
**/validation/**/partial-results/
**/validation/runs/
**/validation/**/output/
!**/validation/wp1-toy/output/
**/validation/wp1-toy/output/*
!**/validation/wp1-toy/output/manifest.json
**/validation/**/.stage-*/
**/validation/**/journal*.tmp

# 本地生成的证明；CI中的最终证明通过GitHub attestation保存
**/validation/wp6-governance/evidence-root.json
**/validation/wp6-governance/evidence-root.sigstore.json
**/validation/wp6-governance/attestation-verification.json
**/validation/wp6-governance/gc-audit*.json
/wp6-evidence/

# 通用大型二进制与临时文件
*.zip
*.7z
*.tar
*.gz
*.npy
*.npz
!**/validation/wp7/versions/**/*.npz
*.h5
*.hdf5
# WP8 的第三方 epsg.npy 与三个 synthetic supplement NPZ 保持为
# 本地/制品存储资产，由 evidence manifest 校验，不作为 Git 持久化证据。
*.tif
*.tiff
*.tmp
