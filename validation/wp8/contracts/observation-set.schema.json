{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wp8-observation-set-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "license_status", "data_mode", "units", "crs", "raw_member_hashes", "lineage", "missingness_policy"],
  "properties": {
    "schema_version": {"const": "wp8-observation-set-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "license_status": {"enum": ["publishable", "local-only-unresolved", "restricted"]},
    "data_mode": {"enum": ["real", "complex", "time_decay", "frequency_response"]},
    "units": {"type": "string", "minLength": 1},
    "crs": {"type": "string", "minLength": 1},
    "complex_layout": {"enum": ["real_then_imag", "interleaved_real_imag"]},
    "raw_member_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "lineage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "missingness_policy": {"const": "preserve-and-flag-never-silently-drop"}
  },
  "allOf": [
    {
      "if": {"properties": {"data_mode": {"const": "complex"}}},
      "then": {"required": ["complex_layout"]}
    }
  ]
}
